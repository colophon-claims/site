{"author":"did:key:z6Mkmz8SWiUshwDMszSqwzMngt7ScNmsEj7vZoFRLjpcZTm9","evaluation":{"digest":{"sha256":"fad8199c49a612501ae957e116f83f1d87194153395aa6820050caf8a8e2c2eb"}},"instructions":"Return exactly ACCEPT or REJECT.","network.jinn.binary-judgment.item-sha256":"sha256:a8a0a7524f4e195a47a9e829fe6948b3706b7f67caea767b44573fcce404ba68","outputs":[{"mediaType":"text/plain; charset=utf-8","name":"judge-response","required":true},{"mediaType":"application/vnd.jinn.binary-judgment.observation.v1+json","name":"judge-observation","required":true},{"mediaType":"application/vnd.inspect-ai.eval-log+json","name":"inspect-log","required":false}],"payload":{"candidateAnswer":"Yes, Jon and Gina do.","evidence":"[D1:4 | 4:04 pm on 20 January, 2023] Jon: Sorry to hear that! I'm starting a dance studio 'cause I'm passionate about dancing and it'd be great to share it with others.\n[D6:8 | 2:35 pm on 16 March, 2023] Gina: Thanks! I'm passionate about fashion trends and finding unique pieces. Plus, I wanted to blend my love for dance and fashion, so it was a perfect match.","itemId":"urn:uuid:d2f98573-c313-51f4-9fe8-249d5650df8e","provenance":{"sourceCommitment":"sha256:f7243e9ab58abdfb757e7d7eb5d4ad911a333bda57d5a84937cae59f88dc6502","timestamp":"2026-04-02T14:22:55Z"},"question":"Do Jon and Gina start businesses out of what they love?","referenceAnswer":"Yes","sources":[{"digest":{"sha256":"f7243e9ab58abdfb757e7d7eb5d4ad911a333bda57d5a84937cae59f88dc6502"}}]},"profile":{"digest":{"sha256":"ebb34d8362e2cc3135847a5ad6f3ee3d9c2d9922a2b827aa9dfcbaf440b22557"},"uri":"https://spec.jinn.network/task-profiles/binary-judgment/2.0"},"protocol":"https://spec.jinn.network/profiles/task-execution/v1"}