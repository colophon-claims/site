{"author":"did:key:z6Mkmz8SWiUshwDMszSqwzMngt7ScNmsEj7vZoFRLjpcZTm9","evaluation":{"digest":{"sha256":"ba9628f77b2f8cbdd34ae0fbbec2d0b62db9b853c27dd323acb37748b8cc6678"}},"instructions":"Return exactly ACCEPT or REJECT.","network.jinn.binary-judgment.item-sha256":"sha256:ff0bb106d77aed90663aa242217fc50d8cde57d77cc82ede70f34180c293fb3c","outputs":[{"mediaType":"text/plain; charset=utf-8","name":"judge-response","required":true},{"mediaType":"application/vnd.jinn.binary-judgment.observation.v1+json","name":"judge-observation","required":true},{"mediaType":"application/vnd.inspect-ai.eval-log+json","name":"inspect-log","required":false}],"payload":{"candidateAnswer":"Laura and Cindy","evidence":"[D27:8 | 6:20 pm on 3 August, 2023] Maria: One of the residents at the shelter, Cindy, wrote it. It's a heartfelt expression of gratitude and shows the impact of the support they receive.\n[D21:19 | 8:43 pm on 3 July, 2023] Maria: One of the shelter residents, Laura, wrote us a letter expressing their gratitude. The impact we made on their life was inspiring!","itemId":"urn:uuid:b1c46752-c86e-53a9-a47a-cd60b3c4df37","provenance":{"sourceCommitment":"sha256:890ba24a02d3ee1133c2272a4e380b6b928075820ef98a4a35744abe350ff33e","timestamp":"2026-04-02T14:22:55Z"},"question":"Who have written notes of gratitude to Maria?","referenceAnswer":"Cindy, Laura","sources":[{"digest":{"sha256":"890ba24a02d3ee1133c2272a4e380b6b928075820ef98a4a35744abe350ff33e"}}]},"profile":{"digest":{"sha256":"ebb34d8362e2cc3135847a5ad6f3ee3d9c2d9922a2b827aa9dfcbaf440b22557"},"uri":"https://spec.jinn.network/task-profiles/binary-judgment/2.0"},"protocol":"https://spec.jinn.network/profiles/task-execution/v1"}