{"author":"did:key:z6Mkmz8SWiUshwDMszSqwzMngt7ScNmsEj7vZoFRLjpcZTm9","evaluation":{"digest":{"sha256":"87c285bfc9762314957f132b2691b9bbb8dcb1f5fe563bd716fec69b70903ec2"}},"instructions":"Return exactly ACCEPT or REJECT.","network.jinn.binary-judgment.item-sha256":"sha256:5f644eee85284c8f47962e52bb843c143a22a79f4b654548fd7f0d1e88ff2189","outputs":[{"mediaType":"text/plain; charset=utf-8","name":"judge-response","required":true},{"mediaType":"application/vnd.jinn.binary-judgment.observation.v1+json","name":"judge-observation","required":true},{"mediaType":"application/vnd.inspect-ai.eval-log+json","name":"inspect-log","required":false}],"payload":{"candidateAnswer":"hiking","evidence":"[D10:12 | 9:28 am on 11 September, 2023] Sam: Sounds great, Evan! Can you help me pick out the stuff? Let's plan a painting session soon. I'm really excited!\n[D10:13 | 9:28 am on 11 September, 2023] Evan: Yeah, Sam - let's do it! Let's get everything ready and paint next Saturday. Can't wait!\n[D10:14 | 9:28 am on 11 September, 2023] Sam: Sounds good, Evan! Can't wait to paint with you next Saturday. It'll be a fun and creative activity.","itemId":"urn:uuid:83fc3eab-853e-5459-980a-da8213138ffb","provenance":{"sourceCommitment":"sha256:527743b8d82bf1958a5bcd7cd17b4638a03d39c0badd62452de5992eb64d3983","timestamp":"2026-04-02T14:22:55Z"},"question":"Which activity do Evan and Sam plan on doing together during September 2023?","referenceAnswer":"painting","sources":[{"digest":{"sha256":"527743b8d82bf1958a5bcd7cd17b4638a03d39c0badd62452de5992eb64d3983"}}]},"profile":{"digest":{"sha256":"ebb34d8362e2cc3135847a5ad6f3ee3d9c2d9922a2b827aa9dfcbaf440b22557"},"uri":"https://spec.jinn.network/task-profiles/binary-judgment/2.0"},"protocol":"https://spec.jinn.network/profiles/task-execution/v1"}