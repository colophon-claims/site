{"author":"did:key:z6Mkmz8SWiUshwDMszSqwzMngt7ScNmsEj7vZoFRLjpcZTm9","evaluation":{"digest":{"sha256":"7bc1bcece99a5ad6a923fda0c43e3167c8402e1737d249dee24899caf678cf55"}},"instructions":"Return exactly ACCEPT or REJECT.","network.jinn.binary-judgment.item-sha256":"sha256:65ef397bb0d754e59e4d907f7cea18ad83b77cc793ffa92eb1437a6d91321cdf","outputs":[{"mediaType":"text/plain; charset=utf-8","name":"judge-response","required":true},{"mediaType":"application/vnd.jinn.binary-judgment.observation.v1+json","name":"judge-observation","required":true},{"mediaType":"application/vnd.inspect-ai.eval-log+json","name":"inspect-log","required":false}],"payload":{"candidateAnswer":"Sara and Kyle","evidence":"[D8:4 | 6:03 pm on 6 March, 2023] John: Thanks, Maria! They're doing great. Our one-year-old is so cute, his name is Kyle!\n[D22:7 | 6:59 pm on 5 July, 2023] John: Thanks, Maria! That picture was from a trip we took last year for my daughter Sara's birthday - so much fun and good memories! My family motivates me to keep striving for change.","itemId":"urn:uuid:3740268c-8188-5507-8bc4-dafeb8340cb0","provenance":{"sourceCommitment":"sha256:524c66bff471c5d6de0c4ad534acc72196b4cc2bda937923f25abf9b793b6bc4","timestamp":"2026-04-02T14:22:55Z"},"question":"What are the names of John's children?","referenceAnswer":"Kyle, Sara","sources":[{"digest":{"sha256":"524c66bff471c5d6de0c4ad534acc72196b4cc2bda937923f25abf9b793b6bc4"}}]},"profile":{"digest":{"sha256":"ebb34d8362e2cc3135847a5ad6f3ee3d9c2d9922a2b827aa9dfcbaf440b22557"},"uri":"https://spec.jinn.network/task-profiles/binary-judgment/2.0"},"protocol":"https://spec.jinn.network/profiles/task-execution/v1"}