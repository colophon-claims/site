{"author":"did:key:z6Mkmz8SWiUshwDMszSqwzMngt7ScNmsEj7vZoFRLjpcZTm9","evaluation":{"digest":{"sha256":"cd364f077fb516a9bd7c1d2cce9fa0c1e4ee4817986d2ec57c9ea331e78504cc"}},"instructions":"Return exactly ACCEPT or REJECT.","network.jinn.binary-judgment.item-sha256":"sha256:9866eddcd9f10f0737bc7880a616b18181e68bda26574120ceef096657bfedcd","outputs":[{"mediaType":"text/plain; charset=utf-8","name":"judge-response","required":true},{"mediaType":"application/vnd.jinn.binary-judgment.observation.v1+json","name":"judge-observation","required":true},{"mediaType":"application/vnd.inspect-ai.eval-log+json","name":"inspect-log","required":false}],"payload":{"candidateAnswer":"A particular type of reptile","evidence":"[D5:6 | 6:59 pm on 18 March, 2022] Nate: I'm drawn to turtles. They're unique and their slow pace is a nice change from the rush of life. They're also low-maintenance and calming. Check out this moment I snapped!\n[D26:9 | 3:56 pm on 4 November, 2022] Joanna: Thanks, Nate! They make me think of strength and perseverance. They help motivate me in tough times - glad you find that inspiring!","itemId":"urn:uuid:68d4f4c2-f6f3-54f4-9cf5-0dd234ed0254","provenance":{"sourceCommitment":"sha256:480e829d184cf2c66c3b80d76f54ce2e2533b7304a35c0d65b56bfce7f274ff1","timestamp":"2026-04-02T14:22:55Z"},"question":"What animal do both Nate and Joanna like?","referenceAnswer":"Turtles.","sources":[{"digest":{"sha256":"480e829d184cf2c66c3b80d76f54ce2e2533b7304a35c0d65b56bfce7f274ff1"}}]},"profile":{"digest":{"sha256":"ebb34d8362e2cc3135847a5ad6f3ee3d9c2d9922a2b827aa9dfcbaf440b22557"},"uri":"https://spec.jinn.network/task-profiles/binary-judgment/2.0"},"protocol":"https://spec.jinn.network/profiles/task-execution/v1"}