{"author":"did:key:z6Mkmz8SWiUshwDMszSqwzMngt7ScNmsEj7vZoFRLjpcZTm9","evaluation":{"digest":{"sha256":"b2b91fb4f775394a49763d7e9fda6dfef7c75a0b59c03d4c34ef598453c5c8c6"}},"instructions":"Return exactly ACCEPT or REJECT.","network.jinn.binary-judgment.item-sha256":"sha256:c153b270ad4c324aa2116e18ef44f0262a2d77678c989d586e98ac4af9e0f759","outputs":[{"mediaType":"text/plain; charset=utf-8","name":"judge-response","required":true},{"mediaType":"application/vnd.jinn.binary-judgment.observation.v1+json","name":"judge-observation","required":true},{"mediaType":"application/vnd.inspect-ai.eval-log+json","name":"inspect-log","required":false}],"payload":{"candidateAnswer":"Freeing and therapeutic, like nothing else in the world","evidence":"[D15:8 | 10:04 am on 19 June, 2023] Gina: Wow, Jon, you must be so excited! You've come so far since we last talked, and tomorrow's gonna be a blast! All those long nights were worth it - so take some time to savor it. Capture the joy and thrill that dance brings - it's magical!","itemId":"urn:uuid:3a34790b-ff87-51eb-aad2-8e04bb23a744","provenance":{"sourceCommitment":"sha256:a46d89fc289e614c8b5b1578a9f70210444e8ced0df7546f13005df60d7935df","timestamp":"2026-04-02T14:22:55Z"},"question":"How does Gina describe the feeling that dance brings?","referenceAnswer":"magical","sources":[{"digest":{"sha256":"a46d89fc289e614c8b5b1578a9f70210444e8ced0df7546f13005df60d7935df"}}]},"profile":{"digest":{"sha256":"ebb34d8362e2cc3135847a5ad6f3ee3d9c2d9922a2b827aa9dfcbaf440b22557"},"uri":"https://spec.jinn.network/task-profiles/binary-judgment/2.0"},"protocol":"https://spec.jinn.network/profiles/task-execution/v1"}