{"author":"did:key:z6Mkmz8SWiUshwDMszSqwzMngt7ScNmsEj7vZoFRLjpcZTm9","evaluation":{"digest":{"sha256":"373bd3f9d26d8cc144bdac22cd1cfa77fc6ba554cc0bed5d32fd27ed1c357abe"}},"instructions":"Return exactly ACCEPT or REJECT.","network.jinn.binary-judgment.item-sha256":"sha256:1ff1b7f4d62aba918e4f92553607f31f65eba3742c58f2991e7e032a5b37ede5","outputs":[{"mediaType":"text/plain; charset=utf-8","name":"judge-response","required":true},{"mediaType":"application/vnd.jinn.binary-judgment.observation.v1+json","name":"judge-observation","required":true},{"mediaType":"application/vnd.inspect-ai.eval-log+json","name":"inspect-log","required":false}],"payload":{"candidateAnswer":"A couple of pet reptile names","evidence":"[D2:20 | 9:49 am on 27 January, 2023] Jolene: I want to show you one of my snakes! They always calm me down and make me happy. This is Susie.\n[D2:22 | 9:49 am on 27 January, 2023] Jolene:  I was playing video games and my pet just slinked out of her cage and coiled up next to me - it was too funny! My second snake Seraphim did it. Look at her sly eyes!","itemId":"urn:uuid:840a5603-c1f8-53b7-a7ae-b1722d79f6ca","provenance":{"sourceCommitment":"sha256:0329dc58f23c0c5d727989c44ff569052e1f7652d533ff4f8eaecb2c7e8bed67","timestamp":"2026-04-02T14:22:55Z"},"question":"What are the names of Jolene's snakes?","referenceAnswer":"Susie, Seraphim","sources":[{"digest":{"sha256":"0329dc58f23c0c5d727989c44ff569052e1f7652d533ff4f8eaecb2c7e8bed67"}}]},"profile":{"digest":{"sha256":"ebb34d8362e2cc3135847a5ad6f3ee3d9c2d9922a2b827aa9dfcbaf440b22557"},"uri":"https://spec.jinn.network/task-profiles/binary-judgment/2.0"},"protocol":"https://spec.jinn.network/profiles/task-execution/v1"}