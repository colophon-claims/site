{"author":"did:key:z6Mkmz8SWiUshwDMszSqwzMngt7ScNmsEj7vZoFRLjpcZTm9","evaluation":{"digest":{"sha256":"5e17b0403aed3864d51c7654e0b2c449fdea78e6cdc8c5d617fd2597660027e2"}},"instructions":"Return exactly ACCEPT or REJECT.","network.jinn.binary-judgment.item-sha256":"sha256:4522b665d046e27f1c41f59e06847529f886c7d51a4dad5520eaaaa011499f69","outputs":[{"mediaType":"text/plain; charset=utf-8","name":"judge-response","required":true},{"mediaType":"application/vnd.jinn.binary-judgment.observation.v1+json","name":"judge-observation","required":true},{"mediaType":"application/vnd.inspect-ai.eval-log+json","name":"inspect-log","required":false}],"payload":{"candidateAnswer":"Star Wars: Thrawn by Timothy Zahn. It is a critically acclaimed and deeply strategic series set in the universe of his favorite franchise.","evidence":"[D27:19 | 5:26 pm on 2 January, 2024] Tim: Harry Potter is my favorite book. It's so immersive!\n[D27:21 | 5:26 pm on 2 January, 2024] Tim: Definitely Star Wars! It's my favorite and never gets old. What about you, do you have any favorite fantasy films?","itemId":"urn:uuid:6e439c0e-d500-59eb-86f2-87f4ec235e23","provenance":{"sourceCommitment":"sha256:6fd2d0677315af2b3e383ec8e1633482b6063dc1d00c6405e38ee193c59ef824","timestamp":"2026-04-02T14:22:55Z"},"question":"What is a Star Wars book that Tim might enjoy?","referenceAnswer":"Star Wars: Jedi Apprentice by Judy Blundell and David Farland. It is a highly rated and immersive series about his favorite movies.","sources":[{"digest":{"sha256":"6fd2d0677315af2b3e383ec8e1633482b6063dc1d00c6405e38ee193c59ef824"}}]},"profile":{"digest":{"sha256":"ebb34d8362e2cc3135847a5ad6f3ee3d9c2d9922a2b827aa9dfcbaf440b22557"},"uri":"https://spec.jinn.network/task-profiles/binary-judgment/2.0"},"protocol":"https://spec.jinn.network/profiles/task-execution/v1"}