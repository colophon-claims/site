{"author":"did:key:z6Mkmz8SWiUshwDMszSqwzMngt7ScNmsEj7vZoFRLjpcZTm9","evaluation":{"digest":{"sha256":"7b145556c9d985ea40aa87e523f4badc95b5e654feb8817c85d5b822f26b49ac"}},"instructions":"Return exactly ACCEPT or REJECT.","network.jinn.binary-judgment.item-sha256":"sha256:83780d780b00e79ed25f74af000c3b5d2c8b4d7773fe9aaf437f6b4433da52d6","outputs":[{"mediaType":"text/plain; charset=utf-8","name":"judge-response","required":true},{"mediaType":"application/vnd.jinn.binary-judgment.observation.v1+json","name":"judge-observation","required":true},{"mediaType":"application/vnd.inspect-ai.eval-log+json","name":"inspect-log","required":false}],"payload":{"candidateAnswer":"That community involvement strengthens bonds and brings people together in meaningful ways","evidence":"[D2:3 | 1:14 pm on 25 May, 2023] Melanie: Thanks, Caroline! The event was really thought-provoking. I'm starting to realize that self-care is really important. It's a journey for me, but when I look after myself, I'm able to better look after my family.","itemId":"urn:uuid:61e1876c-04fd-5065-a289-1a10525bd293","provenance":{"sourceCommitment":"sha256:a3c5d60c34d2bfe8c19aed1b08f9a1814420a72ea54e2983fc1fd30fadeb19df","timestamp":"2026-04-02T14:22:55Z"},"question":"What did Melanie realize after the charity race?","referenceAnswer":"self-care is important","sources":[{"digest":{"sha256":"a3c5d60c34d2bfe8c19aed1b08f9a1814420a72ea54e2983fc1fd30fadeb19df"}}]},"profile":{"digest":{"sha256":"ebb34d8362e2cc3135847a5ad6f3ee3d9c2d9922a2b827aa9dfcbaf440b22557"},"uri":"https://spec.jinn.network/task-profiles/binary-judgment/2.0"},"protocol":"https://spec.jinn.network/profiles/task-execution/v1"}