{"author":"did:key:z6Mkmz8SWiUshwDMszSqwzMngt7ScNmsEj7vZoFRLjpcZTm9","evaluation":{"digest":{"sha256":"f55fea4e280a680c8f77f44d5d70e715c3cfd956eb174547fa9451580e2a61c4"}},"instructions":"Return exactly ACCEPT or REJECT.","network.jinn.binary-judgment.item-sha256":"sha256:3ee79626ddcbb8d641dc02de9668b25f6dde097228398ab268d8c808c46fe971","outputs":[{"mediaType":"text/plain; charset=utf-8","name":"judge-response","required":true},{"mediaType":"application/vnd.jinn.binary-judgment.observation.v1+json","name":"judge-observation","required":true},{"mediaType":"application/vnd.inspect-ai.eval-log+json","name":"inspect-log","required":false}],"payload":{"candidateAnswer":"no, her older brother taught her","evidence":"[D2:28 | 9:49 am on 27 January, 2023] Jolene: Even as a child I learned to play on my own.\n[D24:8 | 2:14 pm on 3 September, 2023] Jolene: I taught myself, but my dad was always supportive and my mom would play games with me. ","itemId":"urn:uuid:ccc19ea2-b6bc-582b-897c-ab8f21a2010f","provenance":{"sourceCommitment":"sha256:ca12e80653881e375fdc9e1acb73451e7afe5f5be8b7b9764f64a2007b34de14","timestamp":"2026-04-02T14:22:55Z"},"question":"Did Jolene teach herself how to play the console?","referenceAnswer":"yes","sources":[{"digest":{"sha256":"ca12e80653881e375fdc9e1acb73451e7afe5f5be8b7b9764f64a2007b34de14"}}]},"profile":{"digest":{"sha256":"ebb34d8362e2cc3135847a5ad6f3ee3d9c2d9922a2b827aa9dfcbaf440b22557"},"uri":"https://spec.jinn.network/task-profiles/binary-judgment/2.0"},"protocol":"https://spec.jinn.network/profiles/task-execution/v1"}