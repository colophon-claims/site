{"author":"did:key:z6Mkmz8SWiUshwDMszSqwzMngt7ScNmsEj7vZoFRLjpcZTm9","evaluation":{"digest":{"sha256":"a6d48845516ac14c05628dcd0d3c3c8fe662b98a8cccc4bab3d6f818e05a08b1"}},"instructions":"Return exactly ACCEPT or REJECT.","network.jinn.binary-judgment.item-sha256":"sha256:4248fd5b4a2238d437f4912d2e6fee18f78883e4619a261367facb827a7acccf","outputs":[{"mediaType":"text/plain; charset=utf-8","name":"judge-response","required":true},{"mediaType":"application/vnd.jinn.binary-judgment.observation.v1+json","name":"judge-observation","required":true},{"mediaType":"application/vnd.inspect-ai.eval-log+json","name":"inspect-log","required":false}],"payload":{"candidateAnswer":"Early November 2022, right before Thanksgiving.","evidence":"[D2:1 | 6:10 pm on 22 December, 2022] Maria: Hey John, been a few days since we chatted. In the meantime, I donated my old car to a homeless shelter I volunteer at yesterday. How's the campaign going? I'm keen to hearabout it.","itemId":"urn:uuid:96654f67-5787-57c1-83a6-bcfe89c87dae","provenance":{"sourceCommitment":"sha256:6e2b755d05b2cb81cc9bb2222b89a06b504cc04d8ec796b98c354b0340c908e1","timestamp":"2026-04-02T14:22:55Z"},"question":"When did Maria donate her car?","referenceAnswer":"21 December 2022","sources":[{"digest":{"sha256":"6e2b755d05b2cb81cc9bb2222b89a06b504cc04d8ec796b98c354b0340c908e1"}}]},"profile":{"digest":{"sha256":"ebb34d8362e2cc3135847a5ad6f3ee3d9c2d9922a2b827aa9dfcbaf440b22557"},"uri":"https://spec.jinn.network/task-profiles/binary-judgment/2.0"},"protocol":"https://spec.jinn.network/profiles/task-execution/v1"}