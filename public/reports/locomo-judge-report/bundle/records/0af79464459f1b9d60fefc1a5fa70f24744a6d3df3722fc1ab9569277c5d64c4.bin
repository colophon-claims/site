{"author":"did:key:z6Mkmz8SWiUshwDMszSqwzMngt7ScNmsEj7vZoFRLjpcZTm9","evaluation":{"digest":{"sha256":"8a9a63f7e1a04c36a97804c49804bd6cae02f1b48c3ec55a8d4eafcb194cd7c5"}},"instructions":"Return exactly ACCEPT or REJECT.","network.jinn.binary-judgment.item-sha256":"sha256:d51e3578c4278f1109946382ddf6045d05c38662311c7fd8fe9f1ff8bbfd8d49","outputs":[{"mediaType":"text/plain; charset=utf-8","name":"judge-response","required":true},{"mediaType":"application/vnd.jinn.binary-judgment.observation.v1+json","name":"judge-observation","required":true},{"mediaType":"application/vnd.inspect-ai.eval-log+json","name":"inspect-log","required":false}],"payload":{"candidateAnswer":"Pomodoro technique","evidence":"[D18:3 | 3:59 pm on 16 November, 2023] Tim: Ouch, bummer about the injury. Hang tight. This week has been swamped with exams for me but I'm plowing through.\n[D18:7 | 3:59 pm on 16 November, 2023] Tim: That's cool! I like breaking up my studying into smaller parts. 25 minutes on, then 5 minutes off for something fun. It's less overwhelming and keeps me on track.","itemId":"urn:uuid:b8d9081e-11b2-5aa4-b455-ec74e5f07e8c","provenance":{"sourceCommitment":"sha256:caccd49fcb1921eae05fc51fdc89405f2f81db5606b1f229e94e2562307d6da5","timestamp":"2026-04-02T14:22:55Z"},"question":"Which popular time management technique does Tim use to prepare for exams?","referenceAnswer":"Pomodoro technique","sources":[{"digest":{"sha256":"caccd49fcb1921eae05fc51fdc89405f2f81db5606b1f229e94e2562307d6da5"}}]},"profile":{"digest":{"sha256":"ebb34d8362e2cc3135847a5ad6f3ee3d9c2d9922a2b827aa9dfcbaf440b22557"},"uri":"https://spec.jinn.network/task-profiles/binary-judgment/2.0"},"protocol":"https://spec.jinn.network/profiles/task-execution/v1"}