to pick up?","referenceAnswer":"Writing a travel blog.","sources":[{"digest":{"sha256":"be926b017c52bf4f715c4020deceda386b2f807616dff866b19d041b06789a8d"}}]},"profile":{"digest":{"sha256":"ebb34d8362e2cc3135847a5ad6f3ee3d9c2d9922a2b827aa9dfcbaf440b22557"},"uri":"https://spec.jinn.network/task-profiles/binary-judgment/2.0"},"protocol":"https://spec.jinn.network/profiles/task-execution/v1"}